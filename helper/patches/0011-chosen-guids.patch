         ddScan = [data[@"ddScan"] integerValue] == 1;
     }
 
+    // imbridge: a GUID the caller chose (a UUID), so it can find exactly this message in chat.db after a timeout
+    NSString *chosenGuid = nil;
+    if ([data[@"guid"] isKindOfClass:[NSString class]] && [[NSUUID alloc] initWithUUIDString:data[@"guid"]] != nil) {
+        chosenGuid = [data[@"guid"] uppercaseString];
+    }
+
