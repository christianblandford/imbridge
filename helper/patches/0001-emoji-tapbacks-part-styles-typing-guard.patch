+// Per-part styles and text effects for send-multipart (macOS 15+): part keys "styles": ["bold","italic","underline","strikethrough"]
+// and "effect": one of scaleRipple, stretch, squish, bounce, big, bloom, somersault, shakeVertical, shakeHorizontal, jitter, small, explode.
+extern long IMTextEffectTypeFromName(NSString *name);
+
++(void) applyPartStyles:(NSDictionary *)dict toString:(NSMutableAttributedString *)str {
+    if ([[NSProcessInfo processInfo] operatingSystemVersion].majorVersion < 15 || [str length] == 0) return;
+    NSRange range = NSMakeRange(0, [str length]);
+    id styles = dict[@"styles"];
+    if ([styles isKindOfClass:[NSArray class]]) {
+        if ([styles containsObject:@"bold"]) [str addAttribute:@"__kIMTextBoldAttributeName" value:@1 range:range];
+        if ([styles containsObject:@"italic"]) [str addAttribute:@"__kIMTextItalicAttributeName" value:@1 range:range];
+        if ([styles containsObject:@"underline"]) [str addAttribute:@"__kIMTextUnderlineAttributeName" value:@1 range:range];
+        if ([styles containsObject:@"strikethrough"]) [str addAttribute:@"__kIMTextStrikethroughAttributeName" value:@1 range:range];
+    }
+    id effect = dict[@"effect"];
+    if ([effect isKindOfClass:[NSString class]] && [effect length] > 0) {
+        long type = IMTextEffectTypeFromName(effect);
+        if (type > 0) [str addAttribute:@"__kIMTextEffectAttributeName" value:@(type) range:range];
+    }
+}
