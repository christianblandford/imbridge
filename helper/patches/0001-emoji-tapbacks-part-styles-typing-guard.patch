+// Custom emoji tapbacks (macOS 15+): reactionType "emoji:👀" adds, "-emoji:👀" removes.
+static NSString *pendingEmoji = nil;
+
++(NSString *) emojiFromReactionType:(NSString *)reactionType {
+    if ([reactionType hasPrefix:@"emoji:"]) return [reactionType substringFromIndex:6];
+    if ([reactionType hasPrefix:@"-emoji:"]) return [reactionType substringFromIndex:7];
+    return nil;
+}
