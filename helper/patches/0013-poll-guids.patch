+// A message GUID the caller chose (a UUID, uppercased as IMCore writes them), or nil to let IMCore pick one.
+static NSString *IMBChosenGuid(id value) {
+    BOOL uuid = [value isKindOfClass:[NSString class]] && [[NSUUID alloc] initWithUUIDString:value] != nil;
+    return uuid ? [value uppercaseString] : nil;
+}
