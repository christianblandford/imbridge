+// imbridge: sticker tapbacks (macOS 15+): a sticker used as a tapback. The sticker is a transfer marked as one, like a
+// sticker the tapback menu makes, and IMTapbackSender sends it as an IMStickerTapback on the message part, the way
+// Messages' own tapbacks go out.
+static void IMBSendStickerTapback(IMChat *chat, NSDictionary *data, NSString *transaction) {
+    id path = data[@"filePath"], sid = data[@"stickerId"], shash = data[@"stickerHash"];
+    id target = data[@"selectedMessageGuid"];
+    if (![path isKindOfClass:[NSString class]] || ![sid isKindOfClass:[NSString class]]
+            || ![shash isKindOfClass:[NSString class]] || ![target isKindOfClass:[NSString class]]) {
+        IMBReply(transaction, @{@"error": @"A sticker tapback needs filePath, stickerId, stickerHash and selectedMessageGuid"});
+        return;
+    }
+    NSInteger part = [data[@"partIndex"] isKindOfClass:[NSNumber class]] ? [data[@"partIndex"] integerValue] : 0;
+    Class tapbackClass = NSClassFromString(@"IMStickerTapback"), senderClass = NSClassFromString(@"IMTapbackSender");
+    SEL makeTapback = NSSelectorFromString(@"initWithTransferGUID:isRemoved:");
+    SEL makeSender = NSSelectorFromString(@"initWithTapback:chat:messagePartChatItem:");
+    if (![tapbackClass instancesRespondToSelector:makeTapback] || ![senderClass instancesRespondToSelector:makeSender]) {
+        IMBReply(transaction, @{@"error": @"This macOS can't send sticker tapbacks"});
+        return;
+    }
+    NSDictionary *info = @{@"pid": @"com.apple.Stickers.UserGenerated.MessagesExtension", @"shash": shash, @"sid": sid,
+                           @"sir": @NO, @"spv": @0, @"suri": @"sticker:///user/identifier/"};
+    @try {
+        IMFileTransfer *transfer = IMBPrepareSticker([NSURL fileURLWithPath:path], info, nil);
+        NSString *transferGuid = [transfer guid];
+        if (transferGuid == nil) {
+            IMBReply(transaction, @{@"error": @"Couldn't prepare the sticker"});
+            return;
+        }
+        [[IMChatHistoryController sharedInstance] loadMessageWithGUID:target completionBlock:^(IMMessage *message) {
+            @try {
+                IMMessagePartChatItem *item = message ? IMBMessagePart(message, part) : nil;
+                if (item == nil) {
+                    IMBReply(transaction, @{@"error": @"Couldn't find that message to tapback"});
+                    return;
+                }
+                id tapback = ((id (*)(id, SEL, id, BOOL))objc_msgSend)([tapbackClass alloc], makeTapback, transferGuid, NO);
+                id sender = ((id (*)(id, SEL, id, id, id))objc_msgSend)([senderClass alloc], makeSender, tapback, chat, item);
+                id sent = ((id (*)(id, SEL))objc_msgSend)(sender, NSSelectorFromString(@"send"));
+                NSString *guid = [sent respondsToSelector:@selector(guid)] ? [sent guid] : [[chat lastSentMessage] guid];
+                IMBReply(transaction, @{@"identifier": guid ?: @""});
+            } @catch (NSException *exception) {
+                IMBReply(transaction, @{@"error": [NSString stringWithFormat:@"Couldn't send the sticker tapback: %@", exception.reason]});
+            }
+        }];
+    } @catch (NSException *exception) {
+        IMBReply(transaction, @{@"error": [NSString stringWithFormat:@"Couldn't send the sticker tapback: %@", exception.reason]});
+    }
+}
