+// The chat item for one part of a message (what stickers and tapbacks attach to), or nil.
+static IMMessagePartChatItem *IMBMessagePart(IMMessage *message, NSInteger part) {
+    IMMessageItem *messageItem = (IMMessageItem *)message._imMessageItem;
+    NSObject *items = messageItem._newChatItems;
+    NSArray *parts = [items isKindOfClass:[NSArray class]] ? (NSArray *)items : (items ? @[items] : @[]);
+    for (id candidate in parts) {
+        if ([candidate respondsToSelector:@selector(index)] && [candidate respondsToSelector:@selector(messagePartRange)]
+                && [(IMMessagePartChatItem *)candidate index] == part) {
+            return (IMMessagePartChatItem *)candidate;
+        }
+    }
+    return nil;
+}
