     // imbridge: schedule a message (Send Later)
     } else if ([event isEqualToString:@"send-later"]) {
         IMChat *chat = [[BlueBubblesHelper sharedInstance] getIMChatFromGuid:data[@"chatGuid"] transaction:transaction];
