+// imbridge: the Python side passes IMBRIDGE_PORT and IMBRIDGE_TOKEN in Messages' environment when it launches it.
+static int helperPort(void) {
+    const char *env = getenv("IMBRIDGE_PORT");
+    if (env != NULL && atoi(env) > 0) return atoi(env);
+    // one port per user account: 45700 for the first (uid 501), +1 for each further user
+    return CLAMP(45700 + (int)getuid() - 501, 1024, 65535);
